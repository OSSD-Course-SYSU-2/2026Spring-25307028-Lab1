        }, Column);
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            // å›¾æ ‡å±•ç¤ºåŒºåŸŸ
            Flex.create({
                wrap: FlexWrap.Wrap,
                justifyContent: FlexAlign.SpaceEvenly
