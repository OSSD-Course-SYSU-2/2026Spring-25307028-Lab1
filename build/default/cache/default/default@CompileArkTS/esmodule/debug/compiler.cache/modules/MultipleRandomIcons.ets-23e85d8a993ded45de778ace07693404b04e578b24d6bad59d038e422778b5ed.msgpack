import Common from '../common/constants/Const';

@Component
export struct MultipleRandomIcons {
  @State iconIndices: number[] = [];
  @State displayCount: number = 3; // é»˜è®¤å±•ç¤º3ä¸ªå›¾æ ‡
  @State isRefreshing: boolean = false;

  aboutToAppear() {
    // åˆå§‹åŒ–éšæœºå›¾æ ‡
    this.randomizeAllIcons();
  }

  // éšæœºç”ŸæˆæŒ‡å®šæ•°é‡çš„ä¸é‡å¤å›¾æ ‡ç´¢å¼• - ä½¿ç”¨Fisher-Yatesæ´—ç‰Œç®—æ³•
  private randomizeAllIcons() {
    const totalIcons = Common.IMAGE_RESOURCE.length;
    const count = Math.min(this.displayCount, totalIcons);
    
    // åˆ›å»ºç´¢å¼•æ•°ç»„
    const indices: number[] = [];
    for (let i = 0; i < totalIcons; i++) {
      indices.push(i);
    }
    
    // Fisher-Yateséƒ¨åˆ†æ´—ç‰Œ
    for (let i = 0; i < count; i++) {
      const randomPos = i + Math.floor(Math.random() * (totalIcons - i));
      // äº¤æ¢ä½ç½®ï¼ˆä¸ä½¿ç”¨è§£æ„èµ‹å€¼ï¼‰
      const temp = indices[i];
      indices[i] = indices[randomPos];
      indices[randomPos] = temp;
    }
    
    this.iconIndices = indices.slice(0, count);
  }

  // åˆ·æ–°æ‰€æœ‰å›¾æ ‡
  private refreshAllIcons() {
    this.isRefreshing = true;
    setTimeout(() => {
      this.randomizeAllIcons();
      this.isRefreshing = false;
    }, 400);
  }

  build() {
    Column() {
      // å›¾æ ‡å±•ç¤ºåŒºåŸŸ
      Flex({ 
        wrap: FlexWrap.Wrap, 
        justifyContent: FlexAlign.SpaceEvenly 
      }) {
        ForEach(this.iconIndices, (iconIndex: number, index: number) => {
          Column() {
            Image(Common.IMAGE_RESOURCE[iconIndex])
              .width(60)
              .height(60)
              .objectFit(ImageFit.Contain)
              .rotate({ angle: this.isRefreshing ? 360 : 0 })
              .scale({ 
                x: this.isRefreshing ? 0.3 : 1, 
                y: this.isRefreshing ? 0.3 : 1 
              })
              .opacity(this.isRefreshing ? 0.2 : 1)
              .animation({
                duration: 400,
                delay: index * 100, // é”™å¼€åŠ¨ç”»æ—¶é—´
                curve: Curve.EaseInOut
              })
            
            Text(`#${iconIndex + 1}`)
              .fontSize(12)
              .fontColor('#999999')
              .margin({ top: 4 })
          }
          .width(80)
          .height(100)
          .justifyContent(FlexAlign.Center)
        })
      }
      .width('100%')
      .height(200)

      // æ§åˆ¶åŒºåŸŸ
      Column() {
        // æ•°é‡è°ƒèŠ‚
        Row() {
          Text('å±•ç¤ºæ•°é‡:')
            .fontSize(14)
          
          Button('-')
            .width(40)
            .height(30)
            .fontSize(18)
            .margin({ left: 10, right: 10 })
            .enabled(this.displayCount > 1)
            .onClick(() => {
              if (this.displayCount > 1) {
                this.displayCount--;
                this.randomizeAllIcons();
              }
            })
          
          Text(`${this.displayCount}`)
            .fontSize(16)
            .fontWeight(FontWeight.Bold)
            .width(30)
            .textAlign(TextAlign.Center)
          
          Button('+')
            .width(40)
            .height(30)
            .fontSize(18)
            .margin({ left: 10 })
            .enabled(this.displayCount < Common.IMAGE_RESOURCE.length)
            .onClick(() => {
              if (this.displayCount < Common.IMAGE_RESOURCE.length) {
                this.displayCount++;
                this.randomizeAllIcons();
              }
            })
        }
        .margin({ bottom: 15 })

        // åˆ·æ–°æŒ‰é’®
        Button('éšæœºåˆ·æ–°')
          .width(150)
          .height(45)
          .fontSize(16)
          .backgroundColor('#007DFF')
          .onClick(() => {
            this.refreshAllIcons();
          })
      }
      .margin({ top: 20 })
    }
    .width('100%')
    .justifyContent(FlexAlign.Start)
    .padding({ top: 20 })
  }
}
